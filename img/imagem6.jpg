/*!**********************************************************************************************************************************************************************************************************************************************!*\
  !*** css ./node_modules/css-loader/dist/cjs.js??ruleSet[1].rules[4].use[1]!./node_modules/postcss-loader/dist/cjs.js??ruleSet[1].rules[4].use[2]!./node_modules/sass-loader/dist/cjs.js??ruleSet[1].rules[4].use[3]!./src/video/editor.scss ***!
  \**********************************************************************************************************************************************************************************************************************************************/
:root {
  --sescblockvideossidebar-content-height-mobile: 50vh;
  --sescblockvideossidebar-video-height-mobile: 50vh;
  --sescblockvideossidebar-conteiner-height-desktop: 50vh;
  --sescblockvideossidebar-conteiner-height-tablet: 50vh;
  --sescblockvideossidebar-video-width-desktop: 50%;
  --sescblockvideossidebar-video-width-tablet: 50%;
  --sescblockvideossidebar-clip: polygon(0 0, 100% 0, 100% 100%, 0 100%);
}

.sescblockvideo {
  width: 100%;
  position: absolute;
  aspect-ratio: 16/9;
  -o-object-fit: cover;
     object-fit: cover;
  display: block;
}

.btn-play-video {
  position: absolute;
  top: 50%;
  left: 50%;
}

.sescblockvideo-sidebar {
  min-height: var(--sescblockvideossidebar-content-height-mobile) !important;
}

.sescblockvideo-content-video {
  height: calc(var(--sescblockvideossidebar-video-height-mobile) * 1vh) !important;
}

@media (min-width: 768px) {
  .sescblockvideo-container {
    height: var(--sescblockvideossidebar-height-tablet) !important;
  }
  .sescblockvideo-content-video {
    height: 100% !important;
    width: var(--sescblockvideossidebar-video-width-tablet) !important;
    clip-path: var(--sescblockvideossidebar-clip);
  }
  .sescblockvideo-sidebar {
    min-height: auto !important;
  }
}
@media (min-width: 1900px) {
  .sescblockvideo-container {
    height: var(--sescblockvideossidebar-conteiner-height-desktop) !important;
  }
  .sescblockvideo-content-video {
    width: var(--sescblockvideossidebar-video-width-desktop) !important;
  }
}

