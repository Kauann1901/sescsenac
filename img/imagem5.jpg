            <script>
            (function () {
                var sliders = document.querySelectorAll('[data-nr-slider]');
                if (!sliders.length) {
                    return;
                }
                sliders.forEach(function (slider) {
                    var slides = slider.querySelectorAll('[data-nr-slide]');
                    if (slides.length <= 1) {
                        return;
                    }
                    var index = 0;
                    var prev = slider.querySelector('[data-nr-prev]');
                    var next = slider.querySelector('[data-nr-next]');

                    var showSlide = function (nextIndex) {
                        slides[index].classList.remove('is-active');
                        index = (nextIndex + slides.length) % slides.length;
                        slides[index].classList.add('is-active');
                    };

                    if (prev) {
                        prev.addEventListener('click', function () {
                            showSlide(index - 1);
                        });
                    }
                    if (next) {
                        next.addEventListener('click', function () {
                            showSlide(index + 1);
                        });
                    }
                });
            })();
        </script>
        </div>
