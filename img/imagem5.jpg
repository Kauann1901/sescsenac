.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8px 20px 8px 0;
    color: white;
    font-family: Arial, sans-serif;
    font-size: 14px;
}
.top-bar .left-items a{
    color: #FFF !important;
    font-family: 'Libre Franklin', Helvetica, Arial, Lucida, sans-serif;
    text-decoration: none;
    margin-right: 4px;
}
.left-items {
    display: flex;
    align-items: center;
    gap: 15px;
}

.links {
    display: flex;
    align-items: center;
    gap: 10px;
}

.right-items {
    display: flex;
    align-items: center;
    gap: 12px;
}

.icon-circle {
    width: 25px;
    height: 25px;
    border: 1px solid white;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    font-size: 14px;
    cursor: pointer;
}

.search-btn {
    background: transparent;
    border: none;
    color: white;
    font-size: 20px;
    cursor: pointer;
}

.lang-select select {
    background: transparent;
    background-image: none!important;
    border: none;
    color: white;
    font-size: 14px;
    cursor: pointer;
    outline: none;
    appearance: none;
    padding-right: 20px;
}

.lang-select {
    position: relative;
}

.lang-select::after {
    content: "▼";
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: white;
    pointer-events: none;
    font-size: 10px;
}
.lang-select select option {
    background-color: #24404c;
    color: white;
}
</style>
